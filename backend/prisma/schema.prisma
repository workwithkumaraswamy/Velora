// VÉLORA - Premium Multi-Category Fashion Dropshipping Marketplace
// Prisma Schema for MySQL 8

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  SUPER_ADMIN
  MENS_MANAGER
  WOMENS_MANAGER
  KIDS_MANAGER
  ORDER_MANAGER
  SUPPORT_MANAGER
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  PROCESSING
  SUPPLIER_REQUESTED
  SUPPLIER_CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
  WALLET
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PICKED_UP
  RECEIVED
  REFUND_ISSUED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SupplierOrderStatus {
  DRAFT
  REQUESTED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

// ==========================================
// USER & RBAC
// ==========================================

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  phone            String?           @unique
  passwordHash     String
  firstName        String
  lastName         String
  role             RoleType          @default(CUSTOMER)
  avatar           String?
  isActive         Boolean           @default(true)
  emailVerified    Boolean           @default(false)
  phoneVerified    Boolean           @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  addresses        UserAddress[]
  orders           Order[]
  cart             Cart?
  wishlist         Wishlist?
  reviews          Review[]
  returnRequests   ReturnRequest[]
  supportTickets   SupportTicket[]
  notifications    Notification[]
  couponUsages     CouponUsage[]
  auditLogs        AuditLog[]
  userPermissions  UserPermission[]

  @@index([email])
  @@index([role])
}

model Permission {
  id               String            @id @default(uuid())
  code             String            @unique // e.g. "products:write", "orders:manage"
  description      String
  category         String            // "catalog", "orders", "suppliers", etc.
  userPermissions  UserPermission[]

  @@index([code])
}

model UserPermission {
  id               String      @id @default(uuid())
  userId           String
  permissionId     String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission       Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model UserAddress {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName         String
  phone            String
  houseNumber      String
  street           String
  area             String
  city             String
  state            String
  pincode          String
  landmark         String?
  addressType      String      @default("Home") // Home, Office, Other
  isDefault        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([userId])
  @@index([pincode])
}

// ==========================================
// CATALOG: DEPARTMENTS, CATEGORIES, BRANDS
// ==========================================

model Department {
  id               String      @id @default(uuid())
  name             String      @unique // Men, Women, Kids
  slug             String      @unique // men, women, kids
  description      String?     @db.Text
  heroBanner       String?
  heroSubtitle     String?
  isActive         Boolean     @default(true)
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  categories       Category[]
  products         Product[]
  coupons          Coupon[]
  banners          Banner[]
}

model Category {
  id               String      @id @default(uuid())
  departmentId     String
  department       Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name             String
  slug             String
  description      String?     @db.Text
  imageUrl         String?
  isActive         Boolean     @default(true)
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  products         Product[]

  @@unique([departmentId, slug])
  @@index([departmentId])
  @@index([slug])
}

model Brand {
  id               String      @id @default(uuid())
  name             String      @unique
  slug             String      @unique
  logoUrl          String?
  description      String?     @db.Text
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  products         Product[]
}

// ==========================================
// PRODUCTS & VARIANTS
// ==========================================

model Product {
  id                 String             @id @default(uuid())
  title              String
  slug               String             @unique
  departmentId       String
  categoryId         String
  brandId            String?
  supplierId         String?

  department         Department         @relation(fields: [departmentId], references: [id])
  category           Category           @relation(fields: [categoryId], references: [id])
  brand              Brand?             @relation(fields: [brandId], references: [id])
  supplier           Supplier?          @relation(fields: [supplierId], references: [id])

  shortDescription   String?            @db.Text
  description        String             @db.LongText
  highlights         String?            @db.Text // JSON array of string bullets
  specifications     String?            @db.Text // JSON key-value pairs
  careInstructions   String?            @db.Text

  basePrice          Decimal            @db.Decimal(10, 2)
  mrp                Decimal            @db.Decimal(10, 2)
  costPrice          Decimal?           @db.Decimal(10, 2)
  discountPercentage Int                @default(0)

  isFeatured         Boolean            @default(false)
  isTrending         Boolean            @default(false)
  isNewArrival       Boolean            @default(true)
  isPublished        Boolean            @default(true)

  totalStock         Int                @default(0)
  averageRating      Decimal            @default(0.0) @db.Decimal(3, 2)
  reviewCount        Int                @default(0)

  metaTitle          String?
  metaDescription    String?            @db.Text
  metaKeywords       String?            @db.Text

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  images             ProductImage[]
  variants           ProductVariant[]
  attributes         ProductAttribute[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  reviews            Review[]
  supplierProducts   SupplierProduct[]
  inventoryLogs      Inventory[]

  @@index([departmentId])
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([isPublished])
  @@index([isTrending])
  @@index([isNewArrival])
  @@index([slug])
}

model ProductImage {
  id               String      @id @default(uuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  url              String
  altText          String?
  isPrimary        Boolean     @default(false)
  isAiGenerated    Boolean     @default(false)
  styleTag         String?     // e.g. "studio", "lifestyle", "flat-lay", "white-bg"
  sortOrder        Int         @default(0)
  createdAt        DateTime    @default(now())

  @@index([productId])
}

model ProductVariant {
  id               String       @id @default(uuid())
  productId        String
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  size             String       // e.g. "S", "M", "L", "XL", "UK 8", "Free Size"
  color            String       // e.g. "Midnight Black", "Champagne Beige"
  colorHex         String?      // e.g. "#1A1A1A"
  sku              String       @unique
  barcode          String?
  stock            Int          @default(0)
  reservedStock    Int          @default(0)
  priceOverride    Decimal?     @db.Decimal(10, 2)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  cartItems        CartItem[]
  orderItems       OrderItem[]
  inventoryLogs    Inventory[]

  @@index([productId])
  @@index([sku])
}

model ProductAttribute {
  id               String      @id @default(uuid())
  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String      // e.g. "Material", "Fit", "Pattern", "Occasion"
  value            String      // e.g. "100% Egyptian Cotton", "Slim Fit", "Solid", "Casual"

  @@index([productId])
}

model Inventory {
  id               String          @id @default(uuid())
  productId        String
  variantId        String?
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityChange   Int             // positive for restock, negative for deduction
  previousStock    Int
  newStock         Int
  reason           String          // "RESTOCK", "ORDER_PLACED", "ORDER_CANCELLED", "MANUAL_ADJUSTMENT"
  referenceId      String?         // orderId or supplierOrderId
  createdAt        DateTime        @default(now())

  @@index([productId])
  @@index([variantId])
}

// ==========================================
// DROPSHIPPING SUPPLIERS
// ==========================================

model Supplier {
  id               String             @id @default(uuid())
  name             String
  code             String             @unique // e.g. "SUP-IND-01"
  contactName      String?
  contactEmail     String
  contactPhone     String?
  website          String?
  address          String?            @db.Text
  integrationType  String             @default("MANUAL") // MANUAL, REST_API, CSV_FEED
  apiEndpoint      String?
  apiKeyEncrypted  String?
  rating           Decimal            @default(4.5) @db.Decimal(2, 1)
  leadTimeDays     Int                @default(3)
  isActive         Boolean            @default(true)
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  products         Product[]
  supplierProducts SupplierProduct[]
  supplierOrders   SupplierOrder[]
  importJobs       ProductImportJob[]
}

model SupplierProduct {
  id               String      @id @default(uuid())
  supplierId       String
  productId        String
  supplier         Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplierSku      String
  supplierCost     Decimal     @db.Decimal(10, 2)
  externalUrl      String?
  stockAvailable   Int         @default(100)
  lastSyncAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([productId])
}

model SupplierOrder {
  id                 String              @id @default(uuid())
  supplierId         String
  orderId            String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplierOrderRef   String?             // Supplier's confirmation ref
  status             SupplierOrderStatus @default(REQUESTED)
  totalCost          Decimal             @db.Decimal(10, 2)
  courierName        String?
  trackingNumber     String?
  requestedAt        DateTime            @default(now())
  confirmedAt        DateTime?
  shippedAt          DateTime?
  notes              String?             @db.Text

  items              SupplierOrderItem[]

  @@index([supplierId])
  @@index([orderId])
}

model SupplierOrderItem {
  id                 String         @id @default(uuid())
  supplierOrderId    String
  supplierOrder      SupplierOrder  @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  orderItemId        String
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  supplierSku        String
  quantity           Int
  unitCost           Decimal        @db.Decimal(10, 2)

  @@index([supplierOrderId])
  @@index([orderItemId])
}

// ==========================================
// CART & WISHLIST
// ==========================================

model Cart {
  id               String      @id @default(uuid())
  userId           String?     @unique
  sessionId        String?     @unique
  user             User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items            CartItem[]
}

model CartItem {
  id               String          @id @default(uuid())
  cartId           String
  productId        String
  variantId        String?
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id])
  size             String
  color            String
  quantity         Int             @default(1)
  unitPrice        Decimal         @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            WishlistItem[]
}

model WishlistItem {
  id               String      @id @default(uuid())
  wishlistId       String
  productId        String
  wishlist         Wishlist    @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime    @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

// ==========================================
// ORDERS, SHIPMENTS & PAYMENTS
// ==========================================

model Order {
  id                     String               @id @default(uuid())
  orderNumber            String               @unique // e.g. "VEL-2026-89412"
  userId                 String
  user                   User                 @relation(fields: [userId], references: [id])
  status                 OrderStatus          @default(PENDING)
  paymentStatus          PaymentStatus        @default(PENDING)
  paymentMethod          PaymentMethod        @default(COD)

  subtotal               Decimal              @db.Decimal(10, 2)
  discountAmount         Decimal              @default(0.0) @db.Decimal(10, 2)
  shippingFee            Decimal              @default(0.0) @db.Decimal(10, 2)
  taxAmount              Decimal              @default(0.0) @db.Decimal(10, 2)
  totalAmount            Decimal              @db.Decimal(10, 2)

  shippingAddressSnapshot String             @db.Text // JSON copy of chosen address
  customerNotes          String?              @db.Text
  cancelReason           String?              @db.Text

  placedAt               DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  payments               Payment[]
  refunds                Refund[]
  shipments              Shipment[]
  supplierOrders         SupplierOrder[]
  returnRequests         ReturnRequest[]
  couponUsages           CouponUsage[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([placedAt])
}

model OrderItem {
  id                 String              @id @default(uuid())
  orderId            String
  productId          String
  variantId          String?
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  variant            ProductVariant?     @relation(fields: [variantId], references: [id])

  title              String
  brandName          String?
  imageUrl           String?
  size               String
  color              String
  quantity           Int
  unitPrice          Decimal             @db.Decimal(10, 2)
  subtotal           Decimal             @db.Decimal(10, 2)

  supplierStatus     String              @default("PENDING") // PENDING, ASSIGNED, SHIPPED

  supplierOrderItems SupplierOrderItem[]

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id               String       @id @default(uuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status           OrderStatus
  note             String?      @db.Text
  createdBy        String?      // User ID or "SYSTEM"
  createdAt        DateTime     @default(now())

  @@index([orderId])
}

model Payment {
  id                 String         @id @default(uuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod      PaymentMethod
  transactionId      String?        @unique
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  amount             Decimal        @db.Decimal(10, 2)
  currency           String         @default("INR")
  status             PaymentStatus  @default(PENDING)
  rawResponse        String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([orderId])
  @@index([transactionId])
  @@index([razorpayOrderId])
}

model Refund {
  id                 String         @id @default(uuid())
  orderId            String
  returnRequestId    String?
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequest      ReturnRequest? @relation(fields: [returnRequestId], references: [id])
  refundAmount       Decimal        @db.Decimal(10, 2)
  reason             String?        @db.Text
  status             String         @default("INITIATED") // INITIATED, SUCCESS, FAILED
  razorpayRefundId   String?
  processedAt        DateTime?
  createdAt          DateTime       @default(now())

  @@index([orderId])
  @@index([returnRequestId])
}

model Shipment {
  id                   String       @id @default(uuid())
  orderId              String
  order                Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierName          String       // e.g. "BlueDart", "Delhivery", "DTDC"
  trackingNumber       String
  trackingUrl          String?
  status               String       @default("MANIFESTED") // MANIFESTED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED
  shippedAt            DateTime?
  estimatedDelivery    DateTime?
  deliveredAt          DateTime?
  returnTrackingNumber String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([orderId])
  @@index([trackingNumber])
}

// ==========================================
// COUPONS & CAMPAIGNS
// ==========================================

model Coupon {
  id               String         @id @default(uuid())
  code             String         @unique // e.g. "WELCOME10", "VELORA500"
  description      String?        @db.Text
  discountType     DiscountType   @default(PERCENTAGE)
  discountValue    Decimal        @db.Decimal(10, 2)
  maxDiscount      Decimal?       @db.Decimal(10, 2) // Cap on percentage discount
  minOrderValue    Decimal        @default(0.0) @db.Decimal(10, 2)
  startDate        DateTime       @default(now())
  expiryDate       DateTime
  usageLimit       Int            @default(1000)
  perUserLimit     Int            @default(1)
  timesUsed        Int            @default(0)
  departmentId     String?        // optional department scope
  department       Department?    @relation(fields: [departmentId], references: [id])
  isActive         Boolean        @default(true)
  firstOrderOnly   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  couponUsages     CouponUsage[]

  @@index([code])
}

model CouponUsage {
  id               String       @id @default(uuid())
  couponId         String
  userId           String
  orderId          String
  coupon           Coupon       @relation(fields: [couponId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountApplied  Decimal      @db.Decimal(10, 2)
  usedAt           DateTime     @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

model Campaign {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique
  description      String?      @db.Text
  bannerUrl        String?
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
}

// ==========================================
// REVIEWS & RATINGS
// ==========================================

model Review {
  id                 String       @id @default(uuid())
  productId          String
  userId             String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int          // 1 to 5
  title              String?
  comment            String       @db.Text
  isVerifiedPurchase Boolean      @default(true)
  isApproved         Boolean      @default(true)
  photos             String?      @db.Text // JSON array of uploaded images
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([productId])
  @@index([userId])
}

// ==========================================
// RETURNS & SUPPORT TICKETS
// ==========================================

model ReturnRequest {
  id               String       @id @default(uuid())
  orderId          String
  userId           String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason           String       // e.g. "DEFECTIVE", "SIZE_DOES_NOT_FIT", "QUALITY_ISSUE", "NOT_AS_DESCRIBED"
  detailedReason   String       @db.Text
  status           ReturnStatus @default(PENDING)
  refundAmount     Decimal      @db.Decimal(10, 2)
  bankDetails      String?      @db.Text // JSON for COD refunds (UPI ID / IFSC & Account)
  proofImages      String?      @db.Text // JSON array of images
  adminNotes       String?      @db.Text
  requestedAt      DateTime     @default(now())
  resolvedAt       DateTime?

  refunds          Refund[]

  @@index([orderId])
  @@index([userId])
}

model SupportTicket {
  id               String          @id @default(uuid())
  ticketNumber     String          @unique // e.g. "TCK-84920"
  userId           String
  orderId          String?
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          String
  department       String          @default("General") // Orders, Returns, Sizing, General
  priority         TicketPriority  @default(MEDIUM)
  status           TicketStatus    @default(OPEN)
  messages         String          @db.LongText // JSON array of { sender: 'user'|'agent', text: string, sentAt: string }
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([ticketNumber])
}

// ==========================================
// NOTIFICATIONS & AUDIT
// ==========================================

model Notification {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  message          String       @db.Text
  type             String       @default("ORDER") // ORDER, PROMO, SYSTEM
  isRead           Boolean      @default(false)
  link             String?
  createdAt        DateTime     @default(now())

  @@index([userId])
}

model NewsletterSubscriber {
  id               String       @id @default(uuid())
  email            String       @unique
  isActive         Boolean      @default(true)
  subscribedAt     DateTime     @default(now())

  @@index([email])
}

model Banner {
  id               String       @id @default(uuid())
  title            String
  subtitle         String?
  targetUrl        String
  imageUrl         String
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id])
  placement        String       @default("HERO") // HERO, MID_BANNER, PROMO_STRIP
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
}

model AIJob {
  id               String       @id @default(uuid())
  jobType          String       // "DESCRIPTION_GEN", "IMAGE_GEN", "PRODUCT_ENRICHMENT"
  prompt           String       @db.Text
  modelName        String
  provider         String       // "HUGGINGFACE", "STABLE_DIFFUSION", "OPENAI", "LOCAL_RULE_BASED"
  inputPayload     String?      @db.LongText // JSON
  outputResult     String?      @db.LongText // JSON or text/image URL
  status           String       @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  tokensUsed       Int          @default(0)
  errorMessage     String?      @db.Text
  createdAt        DateTime     @default(now())
}

model AIProvider {
  id               String       @id @default(uuid())
  providerKey      String       @unique // "SDXL", "FLUX", "HUGGINGFACE", "GEMINI"
  name             String
  apiUrl           String?
  apiKeyEncrypted  String?
  defaultModel     String
  isActive         Boolean      @default(true)
  generationLimit  Int          @default(100)
  generationsDone  Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ProductImportJob {
  id                 String       @id @default(uuid())
  sourceUrl          String       @db.Text
  supplierId         String?
  supplier           Supplier?    @relation(fields: [supplierId], references: [id])
  status             String       @default("PENDING") // PENDING, PARSED, ENRICHED, PUBLISHED, FAILED
  rawData            String?      @db.LongText // Raw scraped / feed JSON
  extractedData      String?      @db.LongText // Structured data
  createdProductId   String?
  errorMessage       String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([supplierId])
}

model AuditLog {
  id               String       @id @default(uuid())
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  action           String       // "CREATE_PRODUCT", "UPDATE_PRICE", "APPROVE_RETURN", etc.
  entityType       String       // "Product", "Order", "Supplier", "Coupon"
  entityId         String?
  details          String?      @db.Text // JSON
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime     @default(now())

  @@index([userId])
  @@index([entityType])
}
