# ===============================================
# VÉLORA - Premium Multi-Category Fashion Dropshipping Marketplace
# Environment Configuration
# ===============================================

# Server & Runtime
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173

# Database (MySQL 8)
DATABASE_URL="mysql://velora_user:VeloraPass2026@localhost:3306/velora_db"

# Authentication & Security
JWT_SECRET="velora_jwt_secret_key_luxury_fashion_2026_super_secure"
JWT_REFRESH_SECRET="velora_jwt_refresh_secret_luxury_fashion_2026_secure"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateway (Razorpay India Test Credentials)
RAZORPAY_KEY_ID="rzp_test_velora_2026_mock"
RAZORPAY_KEY_SECRET="rzp_secret_velora_mock_luxury_dev"

# Cloud Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="velora-fashion"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"

# Notifications (SMTP Transactional Mail)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="velora_notifications"
SMTP_PASS="velora_smtp_secret"
SMTP_FROM="\"VÉLORA Concierge\" <concierge@velorafashion.com>"

# AI Product Studio (Pluggable: SDXL / FLUX / HuggingFace / Local Rule-Engine)
AI_DEFAULT_PROVIDER="LOCAL_RULE_BASED"
HUGGINGFACE_API_KEY=""
STABLE_DIFFUSION_API_KEY=""
OPENAI_API_KEY=""

# Shipping & Logistics
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
FREE_SHIPPING_THRESHOLD=1499
STANDARD_SHIPPING_FEE=99
